<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Erişilebilirlik ayarlarını aç" />

        <!-- ===== Bugün ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Bugün kaydırılan video"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="0"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSplit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTodayTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textSize="15sp" />

        <!-- ===== İstatistikler ===== -->
        <TextView
            style="@style/Section"
            android:text="İstatistikler" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp" />

        <!-- ===== 30 gün grafiği ===== -->
        <TextView
            style="@style/Section"
            android:text="Son 30 gün" />

        <com.med.shortscounter.BarChartView
            android:id="@+id/chart30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== Saatlik dağılım ===== -->
        <TextView
            style="@style/Section"
            android:text="Saatlere göre (son 30 gün)" />

        <com.med.shortscounter.BarChartView
            android:id="@+id/chartHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvPeak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <!-- ===== Geçmiş ===== -->
        <TextView
            style="@style/Section"
            android:text="Geçmiş" />

        <TextView
            android:id="@+id/tvHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnHistoryMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tüm geçmişi göster" />

        <!-- ===== Ayarlar ===== -->
        <TextView
            style="@style/Section"
            android:text="Ayarlar" />

        <Switch
            android:id="@+id/swOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instagram/YouTube'da ekranda sayaç göster"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/swDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hata ayıklama günlüğü"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bugünü sıfırla" />

        <LinearLayout
            android:id="@+id/debugBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Günlüğü temizle" />

            <TextView
                android:id="@+id/tvDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
