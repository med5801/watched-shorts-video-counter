rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'name', 'videos', 'time', 'timedVideos', 'days', 'bestDay',
                 'sessMax', 'sessMaxVideos', 'last7', 'last7Time', 'fastPct', 'updatedAt'])
          && d.name is string
          && d.name.size() >= 2
          && d.name.size() <= 20
          && d.videos is int
          && d.videos >= 0
          && d.videos < 10000000
          && d.time is int
          && d.time >= 0
          && d.last7 is int
          && d.last7 <= d.videos
          && d.updatedAt is timestamp;
      }

      // Sıralamayı herkes okuyabilir
      allow read: if true;
      // İlk katılımda isim belirlenir
      allow create: if isOwner() && validData();
      // Sonraki güncellemelerde isim DEĞİŞTİRİLEMEZ
      allow update: if isOwner() && validData()
        && request.resource.data.name == resource.data.name;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
